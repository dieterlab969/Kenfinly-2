[Unit]
Description=Kenfinly repository webhook authentication gateway
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
DynamicUser=yes
LoadCredential=github-hmac:/etc/kenfinly-webhook/github-hmac
ExecStart=/usr/bin/python3 /usr/local/lib/kenfinly/github_webhook.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
