ROOT = Path(__file__).resolve().parent
STATE = ROOT / "storage/app/kenfinly-local"
STATE_FILE = STATE / "state.json"
HOST = "alpha.my.kenfinly.com"
URL = "https://" + HOST
PHP = Path("/opt/homebrew/opt/php/bin/php")
FPM = Path("/opt/homebrew/opt/php/sbin/php-fpm")
MYSQL = Path("/opt/homebrew/opt/mysql/bin/mysql")
MYSQLD = Path("/opt/homebrew/opt/mysql/bin/mysqld")
MYSQLADMIN = Path("/opt/homebrew/opt/mysql/bin/mysqladmin")
NGINX = Path("/opt/homebrew/bin/nginx")
SITE = Path("/opt/homebrew/etc/nginx/servers/alpha.my.kenfinly.com.conf")
